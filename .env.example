# Placeholder only. Copy to .env.local for Next.js or .env for Prisma CLI.
# The browser UI runs on mock data and does not require PostgreSQL.
DATABASE_URL="postgresql://aynox:change-me@localhost:5432/aynox?schema=public"
MARKET_DATA_PROVIDER="mock"
NEXT_PUBLIC_APP_ENV="demo"

# Server-only deployment mode for trusted research request context.
# This is independent of NEXT_PUBLIC_APP_ENV and must never be client-controlled.
AYNOX_DEPLOYMENT_ENV=demo

# Server-only AI abstraction. Leave blank until a provider/model and terms are approved.
# Never rename these variables with a NEXT_PUBLIC_ prefix.
AYNOX_AI_PROVIDER=
AYNOX_AI_MODEL=
AYNOX_AI_API_KEY=
AYNOX_AI_TIMEOUT_MS=10000
AYNOX_AI_MAX_RETRIES=2
